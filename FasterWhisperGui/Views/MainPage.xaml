<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FasterWhisperGui.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#54D6FF">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#54D6FF" Offset="0" />
                <GradientStop Color="#4E6BFF" Offset="0.52" />
                <GradientStop Color="#D025FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border
            Margin="4"
            Background="#0F1115"
            CornerRadius="0,0,18,18">
            <Grid x:Name="RootGrid" Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainContentTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#54D6FF" Offset="0" />
                        <GradientStop Color="#4E6BFF" Offset="0.52" />
                        <GradientStop Color="#D025FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid
                x:Name="TitleBarGrid"
                Grid.Row="0"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="DragRegion"
                    Grid.Column="0"
                    Background="Transparent" />

                <Button
                    x:Name="MinimizeButton"
                    Grid.Column="1"
                    Width="34"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#3A414D"
                    BorderThickness="0"
                    Click="MinimizeButton_Click"
                    Content="&#xE921;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="11"
                    Foreground="#E8EAED" />

                <Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Width="34"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="11"
                    Foreground="#E8EAED" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Padding="18,6,18,12">
                    <Border
                        x:Name="ShellPanel"
                        Width="620"
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Padding="22"
                        Background="#181B21"
                        BorderBrush="#2A303A"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="WhisperLS - Made with love ♥"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Text="Scegli una traccia audio o video e lascia che il tool ti guidi."
                                    FontSize="12"
                                    Foreground="#9AA3AF"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Height="42"
                                        Padding="14,0"
                                        Background="#101318"
                                        BorderBrush="#2D333D"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock
                                            x:Name="FileNameText"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#8D96A3"
                                            Text="Nessun file selezionato"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Button
                                        Grid.Column="1"
                                        MinWidth="118"
                                        Height="42"
                                        Padding="16,0"
                                        Click="BrowseFileButton_Click"
                                        Content="Seleziona" />
                                </Grid>

                                <TextBlock
                                    x:Name="FileStatusText"
                                    FontSize="12"
                                    Foreground="#9AA3AF"
                                    Text=""
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel
                                x:Name="ModelSelectorPanel"
                                Spacing="7"
                                Opacity="0"
                                Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ModelSelectorTransform" Y="14" />
                                </StackPanel.RenderTransform>

                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#C9D0DA"
                                    Text="Scegli il modello" />

                                <Border
                                    Padding="16,10"
                                    Background="#101318"
                                    BorderBrush="#2D333D"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="SelectedModelText"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#F4F6FA"
                                            Text="tiny" />

                                        <Slider
                                            x:Name="ModelSlider"
                                            Height="32"
                                            Maximum="4"
                                            Minimum="0"
                                            SnapsTo="StepValues"
                                            StepFrequency="1"
                                            TickFrequency="1"
                                            ValueChanged="ModelSlider_ValueChanged" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="11" Foreground="#8D96A3" Text="tiny" TextAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#8D96A3" Text="base" TextAlignment="Center" />
                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="#8D96A3" Text="small" TextAlignment="Center" />
                                            <TextBlock Grid.Column="3" FontSize="11" Foreground="#8D96A3" Text="medium" TextAlignment="Center" />
                                            <TextBlock Grid.Column="4" FontSize="11" Foreground="#8D96A3" Text="turbo" TextAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border
                                x:Name="AnalysisPanel"
                                Padding="14"
                                Background="#101318"
                                BorderBrush="#2D333D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Opacity="0"
                                Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="AnalysisTransform" Y="14" />
                                </Border.RenderTransform>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="AnalysisStatusText"
                                        FontSize="12"
                                        Foreground="#C9D0DA"
                                        Text="Analisi in corso..."
                                        TextWrapping="WrapWholeWords" />

                                    <ProgressBar
                                        x:Name="AnalysisProgressBar"
                                        Height="5"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="0" />

                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock FontSize="12" Foreground="#8D96A3" Text="Qualità stimata" />
                                            <TextBlock x:Name="QualityStarsText" FontSize="16" Foreground="#F5C542" Text="-----" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontSize="12" Foreground="#8D96A3" Text="Tempo stimato" />
                                            <TextBlock x:Name="TimeStarsText" FontSize="16" Foreground="#7CC7FF" Text="-----" />
                                            <TextBlock x:Name="EstimatedTimeText" FontSize="12" Foreground="#9AA3AF" Text="" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel
                                x:Name="ActionPanel"
                                Spacing="7"
                                Opacity="0"
                                Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ActionTransform" Y="14" />
                                </StackPanel.RenderTransform>

                                <Button
                                    x:Name="PrimaryActionButton"
                                    Height="44"
                                    Click="PrimaryActionButton_Click"
                                    Content="Elabora la traccia audio"
                                    Style="{StaticResource AccentButtonStyle}" />

                                <Button
                                    x:Name="OpenOutputButton"
                                    Height="34"
                                    Click="OpenOutputFolderButton_Click"
                                    Content="Apri cartella output"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    x:Name="OperationStatusText"
                                    FontSize="12"
                                    Foreground="#9AA3AF"
                                    Text=""
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
