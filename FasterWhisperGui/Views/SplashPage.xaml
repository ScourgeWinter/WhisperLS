<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FasterWhisperGui.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#54D6FF">

    <Grid x:Name="SplashRoot">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#54D6FF" Offset="0" />
                <GradientStop Color="#4E6BFF" Offset="0.52" />
                <GradientStop Color="#D025FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border
            x:Name="RootBorder"
            Margin="4"
            Background="#0F1115"
            CornerRadius="0,0,18,18">
            <Grid>
                <Border
                    Height="24"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#54D6FF" Offset="0" />
                            <GradientStop Color="#4E6BFF" Offset="0.52" />
                            <GradientStop Color="#D025FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Image
                    x:Name="SplashImage"
                    Width="220"
                    Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="1"
                    Source="ms-appx:///Assets/splash.png"
                    Stretch="Uniform">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="SplashScale" CenterX="110" CenterY="110" ScaleX="0.92" ScaleY="0.92" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>
    </Grid>
</Page>
